# 変数名のみ（値は書かない）。秘密は Secret Manager から実行時に読む。
PORT=
GEMINI_MODE=                      # fake=偽の応答(試験用) / real=Vertex AI
AUTH_MODE=                        # fake=x-dev-user ヘッダを受ける(開発・試験専用。本番では設定しない) / real
GEMINI_LIMIT_PER_USER_PER_DAY=    # 1 日あたりの上限(ユーザーごと)。数は未決
GEMINI_LIMIT_TOTAL_PER_DAY=       # 1 日あたりの上限(全体)。数は未決
GCP_PROJECT_ID=                   # Vertex AI を呼ぶプロジェクト ID（real モードで必須。既定値なし）
GCP_REGION=                       # 省略時 global
GEMINI_MODEL=                     # 省略時は purpose 別の既定（src/config.js）。置くと全 purpose をこのモデルにする
GEMINI_TIMEOUT_MS=                # 省略時 30000
GEMINI_MAX_OUTPUT_TOKENS=         # 省略時 8192
GEMINI_ACCESS_TOKEN=              # ローカル用のアクセストークン（Cloud Run では不要＝メタデータサーバーから取る）
CORS_ORIGINS=                     # 開発用。Web の開発サーバーの Origin をカンマ区切り（例 http://localhost:8081）。本番では空

# 招待コード方式のログイン（AUTH_MODE=invite・値は Secret Manager 等から。ここには書かない）
AUTH_MODE=
TEAM_CODE=
SESSION_SECRET=
TOKEN_TTL_HOURS=

# 端末への通知（Web Push・#211）。3 つ揃わないと /api/push/* は 404。秘密鍵と TICK_SECRET は Secret Manager から。
VAPID_PUBLIC_KEY=                 # base64url（65 バイトの点）
VAPID_PRIVATE_KEY=                # base64url（32 バイトの d）
VAPID_SUBJECT=                    # mailto: かサイトの URL
TICK_SECRET=                      # Cloud Scheduler が POST /api/push/tick に付ける x-tick-secret の値
